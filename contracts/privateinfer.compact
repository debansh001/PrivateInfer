pragma language_version >= 0.22;

// ==============================================================================
// PrivateInfer - Core Privacy Contract
// ==============================================================================
// This smart contract powers the PrivateInfer platform on the Midnight Network.
// It enforces a strict separation between public state and private data processing.
// 
// Privacy Model:
// - Public State (On-Chain): Only opaque identifiers (queryId), cryptographically 
//   secure hashes (commitmentHash, resultHash), state markers, and escrow balances 
//   are stored publicly.
// - Private Witness (Off-Chain): Sensitive inputs (e.g. medical data) and AI outputs 
//   remain strictly off-chain. Caller identities are verified via Zero-Knowledge 
//   Proofs (ZKPs) within local circuits (callerAddress() witness) to guarantee 
//   authorization without leaking the caller's identity publicly.
// ==============================================================================


import CompactStandardLibrary;

export enum QueryStatus { UNKNOWN, PROCESSING, RESULT_READY, PAID, CANCELLED }

export struct Query {
  creator: Bytes<32>;
  provider: Bytes<32>;
  commitmentHash: Bytes<32>;
  resultHash: Bytes<32>;
  status: QueryStatus;
}

export ledger queries: Map<Bytes<32>, Query>;

witness callerAddress(): Bytes<32>;

constructor() {}

export circuit createQuery(queryId: Bytes<32>, commitment: Bytes<32>, providerAddr: Bytes<32>): [] {
  const pubQueryId = disclose(queryId);
  assert(!queries.member(pubQueryId), "Query ID already exists");
  
  const caller = callerAddress();
  
  const newQuery = Query {
    creator: disclose(caller),
    provider: disclose(providerAddr),
    commitmentHash: disclose(commitment),
    resultHash: pad(32, ""),
    status: QueryStatus.PROCESSING
  };
  
  queries.insert(pubQueryId, newQuery);
}

export circuit submitResult(queryId: Bytes<32>, resultProofHash: Bytes<32>): [] {
  const pubQueryId = disclose(queryId);
  assert(queries.member(pubQueryId), "Query ID does not exist");
  const query = queries.lookup(pubQueryId);
  
  assert(query.status == QueryStatus.PROCESSING, "Query not in PROCESSING state");
  
  // Only the assigned provider can submit result
  const caller = callerAddress();
  assert(disclose(caller) == query.provider, "Not assigned provider");
  
  // Update query state
  const updatedQuery = Query {
    creator: query.creator,
    provider: query.provider,
    commitmentHash: query.commitmentHash,
    resultHash: disclose(resultProofHash),
    status: QueryStatus.RESULT_READY
  };
  
  queries.insert(pubQueryId, updatedQuery);
}

export circuit releasePayment(queryId: Bytes<32>): [] {
  const pubQueryId = disclose(queryId);
  assert(queries.member(pubQueryId), "Query ID does not exist");
  const query = queries.lookup(pubQueryId);
  
  assert(query.status == QueryStatus.RESULT_READY, "Result not ready");
  
  // Only creator can release payment
  const caller = callerAddress();
  assert(disclose(caller) == query.creator, "Not the creator");
  
  // In a real implementation this would transfer tokens to providerAddr.
  // We update the status flag to represent the escrow being released.
  const updatedQuery = Query {
    creator: query.creator,
    provider: query.provider,
    commitmentHash: query.commitmentHash,
    resultHash: query.resultHash,
    status: QueryStatus.PAID
  };
  
  queries.insert(pubQueryId, updatedQuery);
}

export circuit cancelQuery(queryId: Bytes<32>): [] {
  const pubQueryId = disclose(queryId);
  assert(queries.member(pubQueryId), "Query ID does not exist");
  const query = queries.lookup(pubQueryId);
  
  assert(query.status == QueryStatus.PROCESSING, "Can only cancel PROCESSING queries");
  
  // Only creator can cancel
  const caller = callerAddress();
  assert(disclose(caller) == query.creator, "Not the creator");
  
  const updatedQuery = Query {
    creator: query.creator,
    provider: query.provider,
    commitmentHash: query.commitmentHash,
    resultHash: query.resultHash,
    status: QueryStatus.CANCELLED
  };
  
  queries.insert(pubQueryId, updatedQuery);
}

